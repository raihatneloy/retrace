# retrace can run fully BYOK: users paste a key into the settings panel and it
# stays in their browser. Optionally, a deployment can hold a key of its own.
#
# Order of preference is: key in the request, then the env var below.

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# OPENROUTER_API_KEY=
# OPENCODE_GO_API_KEY=

# A public deployment should set this to false, otherwise anyone who finds the
# URL can spend the key above. Self-hosting locally, leave it alone.
# RETRACE_ALLOW_ENV_KEY=false
